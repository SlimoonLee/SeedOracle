<Project>
  <PropertyGroup>
    <Sts2Dir>C:\path\to\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <RitsuLibDir>$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDir>
    <!-- RitsuLib 0.6+ root; the project selects compat/<target> for compile-time references. -->
    <RitsuLibReferenceTarget>0.114.0</RitsuLibReferenceTarget>
    <!-- Random Foreseer 0.17.0+ ships a single RandomForeseer.dll; older packages use lib/<version>. -->
    <RandomForeseerDir>$(Sts2Dir)\mods\RandomForeseer</RandomForeseerDir>
  </PropertyGroup>
</Project>
